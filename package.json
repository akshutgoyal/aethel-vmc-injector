{
  "name": "aethel-vmc-injector-web",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://akshutgoyal.github.io/aethel-vmc-injector/",
  "description": "Aethel - VMC Injector: a web app that turns a VMC roll number + activation code into a browser session injector snippet. Runs on localhost with Node and on GitHub Pages as a static site.",
  "scripts": {
    "build": "npm run build:node && npm run build:web && npm run build:pages",
    "build:node": "tsc -p tsconfig.json",
    "build:web": "tsc -p tsconfig.web.json",
    "build:pages": "node scripts/build-pages.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});require('node:fs').rmSync('public',{recursive:true,force:true})\"",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "preview": "npm run build && node dist/preview.js",
    "test": "npm run build:node && node --test test/*.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
